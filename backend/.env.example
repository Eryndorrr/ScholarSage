# OpenAI配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-ada-002

# LLM 可靠性配置
# LLM_FALLBACK_MODELS=  # 备用模型列表，逗号分隔，如 gpt-4,gpt-3.5-turbo-16k
LLM_MAX_RETRIES=3  # 最大重试次数
LLM_RETRY_DELAY=1.0  # 初始重试延迟（秒）
LLM_RETRY_MULTIPLIER=2.0  # 重试延迟倍数（指数退避）
LLM_TIMEOUT=60  # API 请求超时时间（秒）

# 本地部署示例 (Ollama)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3
# EMBEDDING_MODEL=nomic-embed-text

# RAGAS 评估专用配置（可选）
# 如果不配置，默认使用 OpenAI 配置
RAGAS_MODEL=gpt-3.5-turbo
# RAGAS_API_KEY=  # 可选，默认使用 OPENAI_API_KEY
# RAGAS_BASE_URL=  # 可选，默认使用 OPENAI_BASE_URL
# USE_RAGAS_EVALUATION=false  # 是否使用 RAGAS 评估（默认 false，使用增强的备用方法）

# 数据库配置
DATABASE_URL=sqlite:///./data/knowledge.db
CHROMA_PERSIST_DIR=./data/chroma

# 应用配置
APP_NAME=RAG Knowledge Base
DEBUG=true

# 文档处理配置
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Embedding配置
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_WORKERS=3

# 混合检索配置
USE_HYBRID_SEARCH=true
HYBRID_ALPHA=0.5  # 向量检索权重 (0-1)，BM25权重为 1-alpha

# 重排序配置（API方式）
USE_RERANK=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_API_KEY=  # 可选，默认使用 OPENAI_API_KEY
# RERANK_BASE_URL=  # 可选，默认使用 OPENAI_BASE_URL
RERANK_TOP_K=20

# 联网检索配置
WEB_SEARCH_ENABLED=false  # 全局开关，是否允许联网检索
WEB_SEARCH_PROVIDER=duckduckgo  # 搜索引擎: duckduckgo, tavily, bocha
# TAVILY_API_KEY=  # Tavily API Key（使用 tavily 时需要配置）
# BOCHA_API_KEY=  # Bocha API Key（使用 bocha 时需要配置）
WEB_SEARCH_MAX_RESULTS=5  # 每次搜索返回的最大结果数
# WEB_SEARCH_PROXY=http://127.0.0.1:7890  # 代理设置（可选，用于解决网络问题）

# 查询扩展配置
QUERY_EXPANSION_ENABLED=false  # 是否启用查询扩展（全局开关）
QUERY_EXPANSION_HYDE=false  # HyDE：用假设答案替代原始查询做向量检索（会增加延迟）
QUERY_EXPANSION_KEYWORDS=true  # 关键词提取：增强 BM25 检索
QUERY_EXPANSION_SYNONYMS=true  # 同义词扩展：扩大检索覆盖面

# JWT 认证配置
JWT_SECRET=change-me-in-production-use-a-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24